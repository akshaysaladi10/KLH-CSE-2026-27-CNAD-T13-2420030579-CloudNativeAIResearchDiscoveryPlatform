{
  "name": "cloud-native-ai-research-platform",
  "version": "1.0.0",
  "description": "Cloud-Native AI Research Discovery Platform — B.Tech CNAD Project",
  "private": true,
  "scripts": {
    "seed": "node scripts/seed.js",
    "setup": "node scripts/setup.js",
    "dev:gateway": "cd api-gateway && npm run dev",
    "dev:auth": "cd services/auth-service && npm run dev",
    "dev:paper": "cd services/paper-service && npm run dev",
    "dev:search-rec": "cd services/search-recommendation-service && npm run dev",
    "dev:pdf": "cd services/pdf-service && uvicorn app.main:app --reload --port 8001",
    "dev:ai": "cd services/ai-service && uvicorn app.main:app --reload --port 8002",
    "dev:frontend": "cd frontend && npm run dev",
    "install:all": "npm install && cd api-gateway && npm install && cd ../services/auth-service && npm install && cd ../paper-service && npm install && cd ../search-recommendation-service && npm install && cd ../../frontend && npm install",
    "docker:up": "docker compose up -d --build",
    "docker:down": "docker compose down",
    "test:auth": "cd services/auth-service && npm test",
    "test:paper": "cd services/paper-service && npm test",
    "test:search-rec": "cd services/search-recommendation-service && npm test",
    "test:all": "npm run test:auth && npm run test:paper && npm run test:search-rec"
  },
  "keywords": [
    "cloud-native",
    "microservices",
    "research",
    "ai",
    "kubernetes",
    "docker"
  ],
  "author": "",
  "license": "MIT"
}
