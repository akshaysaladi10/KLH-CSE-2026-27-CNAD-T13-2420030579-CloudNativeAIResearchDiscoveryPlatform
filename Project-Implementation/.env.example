# ============================================
# Cloud-Native AI Research Discovery Platform
# Environment Variables
# ============================================
# Copy this file to .env and fill in your values
# NEVER commit the .env file to version control

# ---- General ----
NODE_ENV=development
PORT=3000

# ---- MongoDB Atlas ----
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/research-platform?retryWrites=true&w=majority

# ---- JWT ----
JWT_SECRET=your-super-secret-jwt-key-change-this
JWT_EXPIRES_IN=7d

# ---- AWS S3 ----
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_S3_BUCKET=research-platform-pdfs

# ---- MinIO (Local S3 Alternative) ----
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=research-papers
MINIO_USE_SSL=false

# ---- AI Service ----
AI_PROVIDER=openai
AI_API_KEY=your-ai-api-key
AI_MODEL=gpt-4o-mini
AI_BASE_URL=https://api.openai.com/v1

# ---- Service URLs (Local Development) ----
AUTH_SERVICE_URL=http://localhost:3001
PAPER_SERVICE_URL=http://localhost:3002
SEARCH_SERVICE_URL=http://localhost:3003
RECOMMENDATION_SERVICE_URL=http://localhost:3004
LIBRARY_SERVICE_URL=http://localhost:3005
ANALYTICS_SERVICE_URL=http://localhost:3006
PDF_SERVICE_URL=http://localhost:8001
AI_SERVICE_URL=http://localhost:8002
FRONTEND_URL=http://localhost:5173

# ---- OpenAlex API ----
OPENALEX_EMAIL=your-email@university.edu

# ---- Redis (Optional Caching) ----
REDIS_URL=redis://localhost:6379

# ---- Logging ----
LOG_LEVEL=debug
